# Optional: without a key, a rule-based fallback extractor is used.
ANTHROPIC_API_KEY=
# Optional alternative to ANTHROPIC_API_KEY
ANTHROPIC_AUTH_TOKEN=
SITETWIN_MODEL=claude-sonnet-5-5
# Model for the "Ask" drawer (POST /api/fragen)
SITETWIN_ASK_MODEL=claude-opus-5-5
# Optional Telegram bot (set webhook to https://<host>/api/telegram)
TELEGRAM_BOT_TOKEN=
# Optional: if set, the Telegram webhook only accepts calls carrying this secret
TELEGRAM_WEBHOOK_SECRET=
# Chat that receives superintendent alerts and decisions
TELEGRAM_SUPER_CHAT_ID=
# Digital twin: Hendrik's structured Supabase database (server-side only, never NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
ABLAGE_BUCKET=ablage

# Telefon-Agent (Schritt 5 in KONZEPT.md): ruft bei offenen Signalen über ElevenLabs + Twilio an.
# Agent "Construction Site checkin Agent" und seine Twilio-Nummer "TestRB" liegen im ElevenLabs-Workspace des Teams.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=agent_8101m7atmx88ehe97w3e9b8p2c01
ELEVENLABS_PHONE_NUMBER_ID=phnum_4301kz8wb24gekav3rp53q0dhg7n
# Secret des Post-Call-Webhooks (ElevenLabs → https://<host>/api/telefon/webhook)
ELEVENLABS_WEBHOOK_SECRET=
# Sicherung für Demo und Tests: wenn gesetzt, gehen ALLE Anrufe an diese Nummer (E.164)
TELEFON_TESTNUMMER=
# 1 = Signale auswählen und protokollieren, aber nicht anrufen
TELEFON_TROCKEN=1
# Schützt POST /api/telefon/anrufen (Header X-Telefon-Token); leer = keine Prüfung
TELEFON_TOKEN=
# Ablage (FastAPI), bekommt das Transkript per POST /import/call; leer = nicht weiterleiten
ABLAGE_URL=http://localhost:8000
ABLAGE_IMPORT_TOKEN=
DEFAULT_PROJEKT=BV Simmering
TELEFON_LAENDERVORWAHL=+43
TELEFON_MAX_VERSUCHE=3
TELEFON_WARTEZEIT_MIN=10
