# Create a copy named .env. WHATSAPP_CHATS is the important one: empty means nothing is forwarded.

# Address of the Ablage API
ABLAGE_URL=http://localhost:8000
# Project name under which the messages end up in quellen (own test name, not the demo project)
ABLAGE_PROJEKT=Test Santino

# Allowed chats, comma-separated: group name (exact, case-insensitive) or JID (e.g. 12345-67890@g.us).
# Run "npm run chats" to list your own groups.
WHATSAPP_CHATS=

# Only for login via pairing code instead of QR: own number with country code, digits only
WHATSAPP_NUMMER=

# Media above this size (MB) are not sent along, the text still is
WHATSAPP_MAX_MB=20

# --- Notifier (warnings into a chat), OFF by default ---
# Only active with 1. Sends a warning when the check agent creates an open signal of the project (ABLAGE_PROJEKT) in Supabase.
WHATSAPP_WARNEN=0
# Target: JID or exact group name. MUST also be listed in WHATSAPP_CHATS (same spelling), otherwise the notifier does not start.
WHATSAPP_WARN_CHAT=
# Only signals from this point in time on (ISO, e.g. 2026-11-14T10:00:00Z). Empty = start time of the service.
WHATSAPP_WARN_AB=
# Follow-up message "erledigt" (resolved) once a reported signal is resolved (0 = off)
WHATSAPP_WARN_ERLEDIGT=1
# Polling interval in seconds and upper limit of messages per 10 minutes
WARN_INTERVALL_S=5
WARN_MAX_PRO_10MIN=6
# --- Feedback on warnings (learning loop, first part), OFF by default ---
# With 1: a reaction (👍 ✅ / 👎 ❌), a reply to a warning or a short message ("stimmt", "Fehlalarm") in the warn chat
# is stored on the signal (columns bewertung, bewertung_notiz). Requires WHATSAPP_WARNEN=1. The ONLY write access to Supabase.
WHATSAPP_BEWERTEN=0
# Short confirmation "✅ SiteTwin: Rueckmeldung gespeichert (...)" into the chat (0 = off)
WHATSAPP_BEWERTEN_BESTAETIGEN=1
# Supabase (read; with WHATSAPP_BEWERTEN=1 also PATCH on signale). The key must be allowed to write. Leave empty, then SUPABASE_URL and SUPABASE_SERVICE_KEY from ../.env apply
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
