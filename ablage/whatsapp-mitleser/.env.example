# Kopie als .env anlegen. Wichtig ist WHATSAPP_CHATS: leer heisst, es wird nichts weitergereicht.

# Adresse der Ablage-API
ABLAGE_URL=http://localhost:8000
# Projektname, unter dem die Nachrichten in quellen landen (eigener Testname, nicht das Demo-Projekt)
ABLAGE_PROJEKT=Test Santino

# Erlaubte Chats, durch Komma getrennt: Gruppenname (exakt, Gross/Klein egal) oder JID (z. B. 12345-67890@g.us).
# Mit "npm run chats" die eigenen Gruppen anzeigen lassen.
WHATSAPP_CHATS=

# Nur fuer den Login per Kopplungscode statt QR: eigene Nummer mit Landesvorwahl, nur Ziffern
WHATSAPP_NUMMER=

# Medien ueber dieser Groesse (MB) werden nicht mitgeschickt, der Text schon
WHATSAPP_MAX_MB=20

# --- Melder (Warnungen in einen Chat), standardmaessig AUS ---
# Nur mit 1 aktiv. Schickt eine Warnung, wenn der Pruef-Agent in Supabase ein offenes Signal des Projekts (ABLAGE_PROJEKT) anlegt.
WHATSAPP_WARNEN=0
# Ziel: JID oder exakter Gruppenname. MUSS auch in WHATSAPP_CHATS stehen (gleiche Schreibweise), sonst startet der Melder nicht.
WHATSAPP_WARN_CHAT=
# Nur Signale ab diesem Zeitpunkt (ISO, z. B. 2026-11-14T10:00:00Z). Leer = Startzeit des Dienstes.
WHATSAPP_WARN_AB=
# Folgemeldung "erledigt", wenn ein gemeldetes Signal geloest ist (0 = aus)
WHATSAPP_WARN_ERLEDIGT=1
# Abruf-Takt in Sekunden und Obergrenze Nachrichten je 10 Minuten
WARN_INTERVALL_S=5
WARN_MAX_PRO_10MIN=6
# --- Rueckmeldung zu Warnungen (Lernschleife, erster Teil), standardmaessig AUS ---
# Mit 1: Reaktion (👍 ✅ / 👎 ❌), Antwort auf eine Warnung oder Kurznachricht ("stimmt", "Fehlalarm") im Warn-Chat
# wird am Signal gespeichert (Spalten bewertung, bewertung_notiz). Braucht WHATSAPP_WARNEN=1. EINZIGER Schreibzugriff auf Supabase.
WHATSAPP_BEWERTEN=0
# Kurze Bestaetigung "✅ SiteTwin: Rueckmeldung gespeichert (...)" in den Chat (0 = aus)
WHATSAPP_BEWERTEN_BESTAETIGEN=1
# Supabase (Lesen; mit WHATSAPP_BEWERTEN=1 auch PATCH auf signale). Der Key muss schreiben duerfen. Leer lassen, dann gelten SUPABASE_URL und SUPABASE_SERVICE_KEY aus ../.env
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
