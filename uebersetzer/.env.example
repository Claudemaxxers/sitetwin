# Kopieren nach uebersetzer/.env und ausfüllen. .env nie committen.
SUPABASE_URL=https://<projekt-ref>.supabase.co
SUPABASE_SERVICE_KEY=
ABLAGE_BUCKET=ablage
DEFAULT_PROJEKT=BV Simmering

# Kostensperre (HACKATHON-KOSTENSPERRE, bleibt drin): Claude-Aufrufe nur mit --mit-claude,
# nur wenn nötig (siehe README, Abschnitt Kosten). Der Key wird nur dafür gebraucht;
# ohne Key laufen pytest, trockenlauf und pruefen (feste Regeln).
ANTHROPIC_API_KEY=
# Optional
UEBERSETZER_MODELL=claude-haiku-5-5
UEBERSETZER_EFFORT=medium
UEBERSETZER_KONTEXT=40
