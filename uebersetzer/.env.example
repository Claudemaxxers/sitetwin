# Copy to uebersetzer/.env and fill in. Never commit .env.
SUPABASE_URL=https://<projekt-ref>.supabase.co
SUPABASE_SERVICE_KEY=
ABLAGE_BUCKET=ablage
DEFAULT_PROJEKT=BV Simmering

# Needed for the translation step and the Claude check of the checking agent.
# Without a key only pytest, `trockenlauf --ohne-claude` and `pruefen --ohne-claude` run.
ANTHROPIC_API_KEY=
# Optional
UEBERSETZER_MODELL=claude-haiku-5-5
UEBERSETZER_EFFORT=medium
UEBERSETZER_KONTEXT=40
